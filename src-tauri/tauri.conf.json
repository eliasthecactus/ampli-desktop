{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ampli",
  "version": "1.0.0",
  "identifier": "ch.benavo.ampli.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Ampli",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 150,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* blob: data:",
        "img-src": "'self' data: blob: http://127.0.0.1:*",
        "media-src": "'self' blob: data: http://127.0.0.1:*",
        "font-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline' blob:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob: data:",
        "child-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Your music, books and radio",
    "longDescription": "A free player for your own server: music from Jellyfin, Navidrome and other (Open)Subsonic servers, YouTube Music through Amplicon, audiobooks and ebooks from Audiobookshelf and Jellyfin, and live radio from 34 countries.",
    "copyright": "\u00a9 2026 Elias Frehner",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      }
    },
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/eliasthecactus/ampli-desktop"
  }
}
